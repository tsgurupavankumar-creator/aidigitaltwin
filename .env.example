# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth
# Required. Generate with: openssl rand -base64 48  (the app refuses to start without a real value)
JWT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=""

# ML Service
ML_SERVICE_URL="http://localhost:8000"
ML_TIMEOUT_MS=5000
ML_ENABLED=true

# Seed (prisma db seed). The seed ERASES the tables first and refuses to run unless
# SEED_CONFIRM_WIPE=yes and both passwords are strong (8+ chars, mixed types).
# The old published defaults Student@123 / Faculty@123 are rejected.
SEED_STUDENT_PASSWORD=""
SEED_FACULTY_PASSWORD=""
SEED_CONFIRM_WIPE=""

# Security
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000
CSRF_ENABLED=true

# Public address of the site, used in password-reset emails. Required in production.
APP_URL="http://localhost:3000"

# Email (password reset). Leave SMTP_HOST empty to print reset links to the dev console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AI Digital Twin <no-reply@example.edu>"

# Optional: where the app reads the risk-level settings (default ml/models/risk_config.json)
# RISK_CONFIG_PATH=""

# Optional LLM-assisted recommendation stage (disabled unless explicitly enabled)
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000
LLM_MAX_OUTPUT_TOKENS=1200

# Seed safety: the seed refuses remote databases unless this equals the DATABASE_URL host.
# Never set it for the team's shared database.
# SEED_TARGET_HOST=""
