diff --git a/src/lib/auth/jwt.ts b/src/lib/auth/jwt.ts
index a8ace4f..ae43882 100644
--- a/src/lib/auth/jwt.ts
+++ b/src/lib/auth/jwt.ts
@@ -1,9 +1,28 @@
 import { SignJWT, jwtVerify } from 'jose';
 
+// Placeholder values that have been published in this repository's docs or
+// examples. A secret anyone can read lets anyone forge a session token (and,
+// with signed CSRF tokens, a CSRF token), so they are refused even though
+// they are long enough.
+const KNOWN_PLACEHOLDER_SECRETS = new Set([
+  'generate-a-32-character-minimum-secret-here',
+  'generate-another-32-char-secret-here',
+]);
+const PLACEHOLDER_PATTERN = /generate-|change[-_ ]?me|your[-_ ]?secret|secret[-_]here|placeholder/i;
+
+/** True when `secret` is long enough and is not a published placeholder. */
+export function isUsableSecret(secret: string | undefined | null): secret is string {
+  if (!secret || secret.length < 32) return false;
+  if (KNOWN_PLACEHOLDER_SECRETS.has(secret)) return false;
+  if (PLACEHOLDER_PATTERN.test(secret)) return false;
+  return true;
+}
+
 const rawSecret = process.env.JWT_SECRET;
-if (!rawSecret || rawSecret.length < 32) {
+if (!isUsableSecret(rawSecret)) {
   throw new Error(
-    'JWT_SECRET is missing or too short (min 32 chars). Set it in .env before starting the server.'
+    'JWT_SECRET is missing, too short (min 32 chars) or still the example placeholder. ' +
+      'Generate one with `openssl rand -base64 48` and set it in .env before starting the server.'
   );
 }
 
diff --git a/tests/jwt-secret.test.ts b/tests/jwt-secret.test.ts
new file mode 100644
index 0000000..efa2dd5
--- /dev/null
+++ b/tests/jwt-secret.test.ts
@@ -0,0 +1,43 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { randomBytes } from 'node:crypto';
+
+process.env.JWT_SECRET = randomBytes(48).toString('base64');
+
+const PLACEHOLDER = 'generate-a-32-character-minimum-secret-here';
+
+test('isUsableSecret: refuses the published .env.example placeholder', async () => {
+  const { isUsableSecret } = await import('../src/lib/auth/jwt');
+  assert.equal(isUsableSecret(PLACEHOLDER), false);
+  assert.equal(isUsableSecret('generate-another-32-char-secret-here'), false);
+});
+
+test('isUsableSecret: refuses missing, short and obvious placeholder secrets', async () => {
+  const { isUsableSecret } = await import('../src/lib/auth/jwt');
+  for (const s of [undefined, '', 'short', 'x'.repeat(31), 'please-change-me-to-a-long-random-value-123', 'your-secret-goes-here-0123456789abcdef']) {
+    assert.equal(isUsableSecret(s as string | undefined), false, String(s));
+  }
+});
+
+test('isUsableSecret: accepts a real random secret', async () => {
+  const { isUsableSecret } = await import('../src/lib/auth/jwt');
+  assert.equal(isUsableSecret(randomBytes(48).toString('base64')), true);
+});
+
+test('the server refuses to start with the placeholder secret', () => {
+  const script = "import('./src/lib/auth/jwt').then(()=>{console.log('STARTED');process.exit(0)}).catch(e=>{console.log('REFUSED:'+e.message);process.exit(0)})";
+  const out = execFileSync('npx', ['tsx', '-e', script], {
+    env: { ...process.env, JWT_SECRET: PLACEHOLDER }, encoding: 'utf8', cwd: process.cwd(),
+  });
+  assert.match(out, /REFUSED:.*placeholder/);
+});
+
+test('.env.example no longer ships a usable secret', async () => {
+  const { readFileSync } = await import('node:fs');
+  const { isUsableSecret } = await import('../src/lib/auth/jwt');
+  const env = readFileSync('.env.example', 'utf8');
+  const m = env.match(/^JWT_SECRET=("?)(.*)\1\s*$/m);
+  assert.ok(m, 'JWT_SECRET line present');
+  assert.equal(isUsableSecret(m![2]), false);
+});
